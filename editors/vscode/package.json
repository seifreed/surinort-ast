{
  "name": "surinort-ast",
  "displayName": "Surinort AST",
  "description": "Diagnostics, completion, formatting, quick fixes, and hover information for Suricata and Snort rules.",
  "version": "4.0.0",
  "publisher": "seifreed",
  "license": "GPL-3.0-or-later",
  "homepage": "https://seifreed.github.io/surinort-ast/",
  "repository": {"type": "git", "url": "https://github.com/seifreed/surinort-ast.git"},
  "bugs": {"url": "https://github.com/seifreed/surinort-ast/issues"},
  "categories": ["Linters", "Programming Languages"],
  "engines": {"vscode": "^1.85.0"},
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:suricata",
    "onLanguage:snort2",
    "onLanguage:snort3"
  ],
  "contributes": {
    "commands": [
      {"command": "surinortAst.validateWithEngine", "title": "Surinort AST: Validate With Engine"},
      {"command": "surinortAst.showMatchSpace", "title": "Surinort AST: Show Match-Space Preview"}
    ],
    "languages": [
      {
        "id": "suricata",
        "aliases": ["Suricata rules"],
        "extensions": [".rules", ".suricata"]
      },
      {
        "id": "snort2",
        "aliases": ["Snort 2 rules"],
        "extensions": [".snort2.rules"]
      },
      {
        "id": "snort3",
        "aliases": ["Snort 3 rules"],
        "extensions": [".snort3.rules"]
      }
    ],
    "configuration": {
      "title": "Surinort AST",
      "properties": {
        "surinortAst.lspCommand": {
          "type": "string",
          "default": "surinort-lsp",
          "description": "Executable used to start the Surinort AST language server."
        },
        "surinortAst.engineCommand": {
          "type": "string",
          "default": "",
          "description": "Optional local engine command containing {file}."
        }
      }
    }
  }
}
