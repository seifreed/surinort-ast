{
  "schema_version": 1,
  "engines": [
    {
      "id": "suricata-8.x",
      "engine": "suricata",
      "version": "8.x",
      "dialect": "suricata",
      "manifest": "manifest.json",
      "command": "suricata -T -S {file}"
    },
    {
      "id": "snort2-2.9.x",
      "engine": "snort2",
      "version": "2.9.x",
      "dialect": "snort2",
      "manifest": "manifest.json",
      "command": "snort -T -c /etc/snort/snort.conf -R {file}"
    },
    {
      "id": "snort3-3.x",
      "engine": "snort3",
      "version": "3.x",
      "dialect": "snort3",
      "manifest": "manifest.json",
      "command": "snort -T -c /etc/snort/snort.lua -R {file}"
    }
  ]
}
